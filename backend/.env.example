# Copy to backend/.env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# Database (required)
MONGODB_URI=mongodb://localhost:27017/clinical_platform

# JWT (required). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=24h

# Allowed frontend origin(s) for CORS, comma-separated. Required in production.
FRONTEND_URL=http://localhost:5173

# Email (SMTP) for OTP verification. Required in production.
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Clinical Platform <no-reply@example.com>"

# AI chatbot (Groq, OpenAI-compatible). Without a key the chatbot uses safe fallback replies.
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile

# Emergency number mentioned in chatbot replies (e.g. 911 US, 112 EU/India, 108 India ambulance)
EMERGENCY_NUMBER=911

# Optional: absolute path for uploaded reports (defaults to backend/uploads)
# Use a persistent volume in production.
UPLOAD_DIR=
